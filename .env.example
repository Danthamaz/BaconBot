# Discord bot credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Optional: restrict slash commands to a single channel (channel snowflake ID)
CHANNEL_ID=

# Voice channel to monitor for raid attendance (channel snowflake ID)
RAID_VOICE_CHANNEL_ID=

# Channel where unlinked-player warnings are posted (channel snowflake ID)
ALERT_CHANNEL_ID=

# Channel for TOD (Time of Death) tracking (channel snowflake ID)
TOD_CHANNEL_ID=

# Extra channel where /bank is allowed (channel snowflake ID)
BANK_CHANNEL_ID=

# Officer role IDs for PvP target access and guild bank writes (comma-separated Discord role snowflake IDs)
OFFICER_ROLE_IDS=

# Internal API key for the local REST API (any random string)
API_KEY=
